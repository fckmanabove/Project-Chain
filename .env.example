# =============================================================================
# Application Settings
# =============================================================================
PROJECT_NAME="Project-Chain"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================================================================
# Database (PostgreSQL + pgvector)
# =============================================================================
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=prochain_user
POSTGRES_PASSWORD=prochain_secret_pass
POSTGRES_DB=prochain_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# Cache & Distributed Locks (Redis)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_pass
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# =============================================================================
# Ports Exposure
# =============================================================================
BACKEND_PORT=8000
FRONTEND_PORT=5173

# =============================================================================
# Synology Drive API (Legacy Migration)
# =============================================================================
SYNOLOGY_BASE_URL="https://your-synology-nas:5001"
SYNOLOGY_USERNAME="synology_admin"
SYNOLOGY_PASSWORD="synology_password"
SYNOLOGY_ROOT_FOLDER="/ProjectArchive"

# =============================================================================
# AI Agent & Vector Search
# =============================================================================
OPENAI_API_KEY="sk-..."
EMBEDDING_MODEL="text-embedding-3-small"
LLM_MODEL="gpt-4o"